{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:osahi:schema:v0.1:trajectory-event",
  "title": "TrajectoryEvent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "run_id",
    "seq",
    "type",
    "at",
    "payload",
    "causation_id",
    "correlation_id"
  ],
  "properties": {
    "event_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "seq": { "type": "integer", "minimum": 1 },
    "type": { "type": "string", "minLength": 1 },
    "at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "payload": { "type": "object" },
    "causation_id": { "type": ["string", "null"] },
    "correlation_id": { "type": "string", "minLength": 1 }
  },
  "allOf": [
    { "$ref": "#/$defs/knownPayloads" }
  ],
  "$defs": {
    "telemetry": {
      "type": "object",
      "required": ["trace_id", "span_id", "attributes"],
      "properties": {
        "trace_id": { "type": "string", "minLength": 1 },
        "span_id": { "type": "string", "minLength": 1 },
        "attributes": { "type": "object" }
      }
    },
    "knownPayloads": {
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "run.started" } }, "required": ["type"] },
          "then": {
            "properties": {
              "payload": {
                "required": ["spec_version", "model", "workload", "harness"],
                "properties": { "spec_version": { "const": "0.1.0" } }
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "run.failed" } }, "required": ["type"] },
          "then": { "properties": { "payload": { "required": ["reason"] } } }
        },
        {
          "if": { "properties": { "type": { "const": "run.completed" } }, "required": ["type"] },
          "then": { "properties": { "payload": { "required": ["text"] } } }
        },
        {
          "if": { "properties": { "type": { "const": "model.completed" } }, "required": ["type"] },
          "then": {
            "properties": {
              "payload": { "required": ["kind", "text", "telemetry"] }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "capability.decided" } }, "required": ["type"] },
          "then": {
            "properties": {
              "payload": {
                "required": ["call_id", "capability_id", "effect", "reason", "policy_id"],
                "properties": { "effect": { "enum": ["allow", "deny"] } }
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "tool.failed" } }, "required": ["type"] },
          "then": {
            "properties": {
              "payload": { "required": ["call_id", "tool_name", "error", "idempotent", "telemetry"] }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "checkpoint.created" } }, "required": ["type"] },
          "then": {
            "properties": {
              "payload": {
                "required": ["checkpoint_id", "state_version", "snapshot"],
                "properties": {
                  "snapshot": {
                    "type": "object",
                    "required": ["working_memory", "scratchpad"]
                  }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "recovery.completed" } }, "required": ["type"] },
          "then": {
            "properties": {
              "payload": {
                "required": ["action", "call_id"],
                "properties": { "action": { "enum": ["retry", "rollback", "escalate"] } }
              }
            }
          }
        }
      ]
    }
  }
}
